# Copy this file to .env and paste your Supabase SESSION POOLER connection string.
# Never share or commit .env - it contains your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Share prices (Financial Modeling Prep, free plan). Easiest: run set_fmp_key.bat
FMP_API_KEY=YOUR-FMP-KEY

# News with summaries (Finnhub, free plan). Easiest: run set_finnhub_key.bat
FINNHUB_API_KEY=YOUR-FINNHUB-KEY

# Chatbot: its OWN read-only database account (created by sql/chat_reader_role.sql), session pooler.
# The user name is chat_reader.YOUR-PROJECT-REF - never the postgres admin account.
CHAT_DATABASE_URL=postgresql://chat_reader.YOUR-PROJECT-REF:CHAT-READER-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Optional: ask for a password before the chat page opens
CHAT_PASSWORD=
